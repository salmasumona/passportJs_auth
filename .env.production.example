# Copy this file to /var/www/passportJs_auth/.env on EC2 and replace every placeholder.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/authPassport?retryWrites=true&w=majority
PORT=1800
APP_URL=https://YOUR_DOMAIN
SESSION_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
NODE_ENV=production
