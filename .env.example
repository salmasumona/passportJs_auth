# Application
NODE_ENV=development
PORT=1800
APP_URL=http://localhost:1800

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/authPassport

# Session
# Generate a long random value for production.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Optional: set to true only when the app is served through HTTPS.
SESSION_SECURE=false

# Optional: if running behind Nginx/another reverse proxy.
TRUST_PROXY=false

# Optional cookie domain, e.g. example.com
SESSION_DOMAIN=
